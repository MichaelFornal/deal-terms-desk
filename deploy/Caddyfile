# Base Caddy config for the shared box, installed as /etc/caddy/Caddyfile by deploy/push.sh (Deal Terms Desk owns it).
# Each app's site lives in its own /etc/caddy/sites/<app>.caddy, installed only by that app (this one: deploy/deals.caddy).
# Caddy keeps no access log unless a site `log` directive asks for one; there is none on purpose.
# Its own runtime log (the default logger, into the journal) still records proxy errors, such as the 502s while
# dtd restarts. Those entries carry the request, so the filter deletes the visitor's address, the URL (which holds
# the search query) and the headers, and keeps the error itself.
{
	log default {
		format filter {
			request>remote_ip delete
			request>client_ip delete
			request>uri delete
			request>headers delete
		}
	}
}

import /etc/caddy/sites/*.caddy
